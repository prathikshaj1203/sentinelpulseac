      "id": 6,
      "title": "Motor RPM & Power Usage (W)",
      "type": "bargauge",
      "datasource": {
        "type": "postgres",
        "uid": "telemetry_db"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry_db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT timestamp AS \"time\", machine_id || ' - RPM' AS metric, rpm AS value FROM telemetry_data WHERE $__timeFilter(timestamp) UNION ALL SELECT timestamp AS \"time\", machine_id || ' - Power' AS metric, power_usage AS value FROM telemetry_data WHERE $__timeFilter(timestamp) ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Power.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              },
              {
                "id": "max",
                "value": 20000
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*RPM.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "rotrpm"
              },
              {
                "id": "max",
                "value": 3000
              }
            ]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      }
