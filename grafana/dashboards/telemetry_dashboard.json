          },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT timestamp AS \"Time\", machine_id AS \"Compressor ID\", risk_level AS \"Risk Level\", root_cause AS \"Root Cause\" FROM telemetry_data WHERE risk_level IN ('HIGH', 'CRITICAL') AND $__timeFilter(timestamp) ORDER BY timestamp DESC LIMIT 50",
