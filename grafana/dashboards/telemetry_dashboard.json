      "title": "Air Compressor Health Score",
      "type": "bargauge",
      "datasource": {
        "type": "postgres",
        "uid": "telemetry_db"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry_db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT timestamp AS \"time\", machine_id AS metric, health_score AS value FROM telemetry_data WHERE $__timeFilter(timestamp) ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 40
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
